{
  "name": "gs-console",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../../api/openapi.yaml -o src/api/schema.d.ts",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test"

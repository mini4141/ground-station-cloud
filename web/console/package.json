  "dependencies": {
    "openapi-fetch": "0.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/node": "24.3.0",
    "@vitejs/plugin-react": "5.0.0",
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.2",
    "vite": "7.1.3"
  }
}

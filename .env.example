# Copy to .env for local overrides. Real .env is gitignored.
DATABASE_URL=postgres://gs:gs@localhost:5432/gs?sslmode=disable
HTTP_ADDR=:8080
SIM_TIME_SCALE=20
PLAN_LEAD_MIN=5
PUBLISHER=mqtt
MQTT_URL=ssl://localhost:8883
MQTT_CA=.local/certs/ca.crt
MQTT_CERT=.local/certs/cloud.crt
MQTT_KEY=.local/certs/cloud.key
JWKS_URL=http://localhost:9000/.well-known/jwks.json
UPLOAD_DIR=.local/uploads
UPLOAD_SECRET=dev-upload-secret
AWS_ENDPOINT_URL_SQS=http://localhost:9324
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=ap-southeast-2
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
API_PUBLIC_URL=http://host.docker.internal:8080
CORS_ORIGIN=*
DEVOIDC_ISSUER=http://localhost:9000
LIVE_TABLE=station_live
SQS_QUEUE=gs-events
EVENTS=log
